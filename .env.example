# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
LOG_LEVEL=INFO
# Required (>= 32 chars) when APP_ENV=production:  openssl rand -hex 32
JWT_SECRET=
ENABLED_APIS=rest,graphql,grpc,websocket,webhooks,soap
REST_PORT=3001
GRAPHQL_PORT=3002
GRPC_PORT=3003
WEBSOCKET_PORT=3004
WEBHOOKS_PORT=3005
SOAP_PORT=3006
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
WS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS=
